<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.personalbudgettracker">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalBudgetTracker">

        <!-- 🌟 Splash screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PersonalBudgetTracker.SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Registration screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Main dashboard with fragments -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Add Habit screen -->
        <activity
            android:name=".AddHabitActivity"
            android:exported="false" />

    </application>

</manifest>
